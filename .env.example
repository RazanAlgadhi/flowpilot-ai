# Template only. Never commit .env or real API credentials.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
FLOWPILOT_PUBLIC_DEMO=true
FLOWPILOT_MAX_MODEL_CALLS=8
FLOWPILOT_MAX_OUTPUT_TOKENS=1024
FLOWPILOT_DAILY_API_QUOTA=100
# Optional writable runtime directory; defaults to the OS temporary directory / flowpilot.
# FLOWPILOT_DATA_DIR=/tmp/flowpilot
# For trusted LOCAL development only, set FLOWPILOT_PUBLIC_DEMO=false.
# Optional private-mode database path; otherwise existing flowpilot.db is used.
# FLOWPILOT_DB_PATH=/path/to/local-demo.sqlite3
